ANTHROPIC_API_KEY=
# Optional: needed to harvest GEO (omics_agent.harvest) and raises the NCBI rate limit
NCBI_API_KEY=
# Optional: needed to build embeddings (omics_agent.embed)
HF_TOKEN=
# Optional: run the API on another port when 8000 is taken; then start the web app with OMICS_API_URL=http://localhost:<port>
# OMICS_API_PORT=8010
# Optional: run search on a local OpenAI-compatible model (e.g. vLLM) instead of Claude; ANTHROPIC_API_KEY is then not needed
# LOCAL_LLM_URL=http://localhost:8000/v1
# LOCAL_LLM_MODEL=<served model name>
# LOCAL_LLM_THINK=1   # let the model think before answering; much slower
# Optional: send only the planning call to another OpenAI-compatible service (falls back to the default model if it fails)
# PLAN_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai
# PLAN_LLM_MODEL=gemini-flash-latest
# PLAN_LLM_KEY=<key>
# Optional: send the batched triage and screening calls to such a service too (falls back per batch), with larger batches
# ANSWER_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ANSWER_LLM_MODEL=gemini-flash-lite-latest
# ANSWER_LLM_KEY=<key>
# OMICS_TRIAGE_BATCH=100
# OMICS_SCREEN_BATCH=15
