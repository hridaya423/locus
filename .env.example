ANTHROPIC_API_KEY=
# Optional: needed to harvest GEO (omics_agent.harvest) and raises the NCBI rate limit
NCBI_API_KEY=
# Optional: needed to build embeddings (omics_agent.embed)
HF_TOKEN=
# Optional: run the API on another port when 8000 is taken; then start the web app with OMICS_API_URL=http://localhost:<port>
# OMICS_API_PORT=8010
# Optional: run search on a local OpenAI-compatible model (e.g. vLLM) instead of Claude; ANTHROPIC_API_KEY is then not needed
# LOCAL_LLM_URL=http://localhost:8000/v1
# LOCAL_LLM_MODEL=<served model name>
# LOCAL_LLM_THINK=1   # let the model think before answering; much slower
